{
  "name": "candidgarden_web-fd27",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#prisma-client": "./app/generated/prisma-node/client.ts",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "prebuild": "npm run generate",
    "build": "react-router build",
    "build:worker": "npm run generate && cross-env WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_WORKERS=true react-router build",
    "build:worker:staging": "npm run generate && cross-env WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_WORKERS=true CLOUDFLARE_ENV=staging react-router build",
    "build:worker:production": "npm run generate && cross-env WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_WORKERS=true CLOUDFLARE_ENV=production react-router build",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "dev": "cross-env NODE_ENV=development MOCKS=true node index.ts",
    "dev:no-mocks": "cross-env NODE_ENV=development node index.ts",
    "dev:worker": "npm run generate && cross-env WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_WORKERS=true vite dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "setup": "npm run build && prisma migrate deploy && prisma generate && playwright install",
    "start": "cross-env NODE_ENV=production node index.ts",
    "start:mocks": "cross-env NODE_ENV=production MOCKS=true node index.ts",
    "deploy:staging": "npm run build:worker:staging && cross-env WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_ENV=staging wrangler deploy",
    "deploy:production": "npm run build:worker:production && cross-env WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_ENV=production wrangler deploy",
    "migrate:production-data": "node scripts/migrate-production-data.mjs",
    "interpretations:import": "node --env-file=.env scripts/import-interpretations.mjs",
    "account:researcher": "node scripts/create-researcher-account.mjs",
    "account:researcher:local": "node --env-file=.env scripts/create-researcher-account.mjs --local",
    "stadel:data": "node scripts/stadel-research/prepare-data.mjs",
    "stadel:images": "node scripts/stadel-research/upload-images.mjs",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:dev --silent",
    "test:e2e:dev": "playwright test --ui",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env CI=true playwright test",
    "test:e2e:install": "npx playwright install --with-deps chromium",
    "cf-typegen": "cross-env WRANGLER_LOG_PATH=.wrangler/logs wrangler types --env-file wrangler.types.env",
    "typecheck": "npm run generate && npm run cf-typegen && react-router typegen && tsc",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run"
  },
  "prettier": "@epic-web/config/prettier",
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/app/generated/prisma",
    "/app/generated/prisma-*",
    "/public/build",
    "/playwright-report"
  ],
