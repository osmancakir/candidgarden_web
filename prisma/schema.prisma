// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator nodeClient {
  provider   = "prisma-client"
  output     = "../app/generated/prisma-node"
  runtime    = "nodejs"
  engineType = "client"
}

generator workerClient {
  provider   = "prisma-client"
  output     = "../app/generated/prisma-worker"
  runtime    = "cloudflare"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  name     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image                 UserImage?
  password              Password?
  roles                 Role[]
  sessions              Session[]
  passkey               Passkey[]
  favorites             Favorite[]
  wikiDataVerifications WikiDataVerification[] @relation("VerifiedByUser")
  interpretations       Interpretation[]       @relation("InterpretationAuthor")
  driftVerdicts         DriftVerdict[]
}

model UserImage {
  id        String  @id @default(cuid())
  altText   String?
  objectKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Session {
  id             String   @id @default(cuid())
  expirationDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  // non-unique foreign key
  @@index([userId])
}

model Permission {
  id          String @id @default(cuid())
  action      String // e.g. create, read, update, delete
  entity      String // e.g. user
  access      String // e.g. own or any
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles Role[]

  @@unique([action, entity, access])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Verification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// The type of verification, e.g. "email" or "phone"
  type String

  /// The thing we're trying to verify, e.g. a user's email or phone number
  target String

  /// The secret key used to generate the otp
  secret String

  /// The algorithm used to generate the otp
  algorithm String

  /// The number of digits in the otp
  digits Int

  /// The number of seconds the otp is valid for
  period Int

  /// The valid characters for the otp
  charSet String

  /// When it's safe to delete this verification
  expiresAt DateTime?

  @@unique([target, type])
}

model Passkey {
  id             String   @id
  aaguid         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publicKey      Bytes
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  webauthnUserId String
  counter        BigInt
  deviceType     String // 'singleDevice' or 'multiDevice'
  backedUp       Boolean
  transports     String? // Stored as comma-separated values

  @@index(userId)
}

// Legacy Candid Garden domain data is retained while the application routes are
// migrated separately. Image binaries are never stored in PostgreSQL: legacy
// source paths are kept for audit/compatibility and objectKey points to the
// private production S3 bucket.
model Artist {
  id                   Int                   @id @default(autoincrement())
  name                 String
  wikiDataId           String?
  wikiDataVerification WikiDataVerification?
  resources            Resource[]

  @@index([name])
}

model Resource {
  id            Int     @id @default(autoincrement())
  artistId      Int?    @map("artist_id")
  title         String?
  titleEn       String? @map("title_en")
  notBefore     Int?    @map("not_before")
  notAfter      Int?    @map("not_after")
  location      String?
  /// What the cataloguer wrote. Kept as written: it is what the archive filter
  /// and the work page still read, and it is the only record for the ~10,500
  /// works whose holder could not be reconciled. `institutionId` is the
  /// resolved form beside it, not a replacement for it.
  institution   String?
  /// The reconciled holder, where one was identified with a Wikidata QID.
  /// Null means "not reconciled", never "no holder" — check `institution`.
  institutionId Int?    @map("institution_id")
  path          String?
  objectKey     String? @unique
  wikiDataId    String?
  highlight     Boolean @default(false)

  artist                Artist?                   @relation(fields: [artistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  institutionRef        Institution?              @relation(fields: [institutionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  taggings              Tagging[]
  relationsAsFirst      Relation[]                @relation("Resource1")
  relationsAsSecond     Relation[]                @relation("Resource2")
  favorites             Favorite[]
  confessionLinks       ConfessionArt[]
  wikiDataVerification  WikiDataVerification?
  interpretations       Interpretation[]
  interpretationVectors InterpretationEmbedding[]
  driftVerdicts         DriftVerdict[]

  @@index([artistId])
  @@index([highlight])
  @@index([title, location])
  @@index([institutionId])
}

/// A holder of works, reconciled to one Wikidata entity.
///
/// One row per institution, not per spelling: the archive names the Rijksmuseum
/// four different ways and they are all Q190804, which is the whole point of
/// carrying an identifier. `name` is the archive's own commonest spelling rather
/// than the Wikidata label, because the label is English-first — "Louvre
/// Museum", "Museum of Art and Crafts Hamburg" — and this is a German archive
/// that already shows the cataloguer's wording on the work page.
model Institution {
  id                   Int                   @id @default(autoincrement())
  name                 String
  wikiDataId           String?               @unique
  imageUrl             String?
  objectKey            String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  wikiDataVerification WikiDataVerification?
  resources            Resource[]

  @@index([name])
}

model WikiDataVerification {
  id            Int       @id @default(autoincrement())
  status        String    @default("PENDING")
  notes         String?
  verifiedAt    DateTime?
  verifiedById  String?
  artistId      Int?      @unique
  resourceId    Int?      @unique
  institutionId Int?      @unique

  verifiedBy  User?        @relation("VerifiedByUser", fields: [verifiedById], references: [id])
  artist      Artist?      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  resource    Resource?    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

/// A written reading of one work at one Panofsky level. Levels II and III cannot
/// be derived from `Tagging` the way Level I is — "this depicts an Annunciation"
/// is a claim somebody makes, not a number you can sum — so the claim is stored
/// here together with who made it. `source` is the field that matters: the
/// dossier distinguishes human from machine provenance for its tags, and prose
/// is held to the same standard rather than being presented as scholarship.
model Interpretation {
  id          String    @id @default(cuid())
  resourceId  Int       @map("resource_id")
  /// Panofsky level this reading belongs to: 2 (iconographic) or 3 (iconological).
  level       Int
  body        String
  /// EDITORIAL (written by a person) | MODEL (machine-drafted) | IMPORTED.
  source      String    @default("EDITORIAL")
  authorId    String?
  /// Where the reading came from — a citation, or the model and run that wrote it.
  citation    String?
  /// Null means drafted but not shown; the dossier only reads published rows.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource  Resource                 @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author    User?                    @relation("InterpretationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  embedding InterpretationEmbedding?

  @@unique([resourceId, level])
  @@index([resourceId, level, publishedAt])
}

/// One bge-m3 vector per interpretation, for the semantic search in
/// `app/utils/semantic-search.server.ts`.
///
/// Prisma cannot read or write `vector` columns — a model carrying a required
/// `Unsupported` field is excluded from `create`/`update` and the column never
/// appears in a select — so every write goes through
/// `scripts/embed-interpretations.mjs` and every read through `$queryRaw`. The
/// model is declared here anyway so `prisma migrate` does not see the table as
/// drift and try to drop it. The vector index has no schema representation and
/// lives only in the migrations — currently IVFFlat, see
/// `20260803190000_replace_hnsw_with_ivfflat` for why it is not HNSW.
model InterpretationEmbedding {
  interpretationId String                      @id @map("interpretation_id")
  resourceId       Int                         @map("resource_id")
  level            Int
  embedding        Unsupported("vector(1024)")
  model            String
  inputHash        String                      @map("input_hash")
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  interpretation Interpretation @relation(fields: [interpretationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource       Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([resourceId])
  @@index([level])
}

model Relation {
  id          Int    @id @default(autoincrement())
  resourceId1 Int    @map("resource_id_1")
  resourceId2 Int    @map("resource_id_2")
  type        String

  resource1 Resource @relation("Resource1", fields: [resourceId1], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource2 Resource @relation("Resource2", fields: [resourceId2], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([resourceId1, resourceId2, type])
}

model Tag {
  id       String    @id
  name     String
  language String
  category String?
  safety   String?
  human    Int       @default(0)
  aiGpt4o  Int       @default(0) @map("ai_gpt_4o")
  taggings Tagging[]

  @@index([name, language])
  @@index([category, safety])
}

model Tagging {
  id         Int    @id @default(autoincrement())
  resourceId Int    @map("resource_id")
  tagId      String @map("tag_id")
  frequency  Int

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([resourceId, tagId])
}

model Favorite {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  resourceId Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

/// One verdict on one work in the drift: PULL, PUSH or REST.
///
/// A force rather than a rating. The work either drew the reader towards it,
/// pushed them off, or exerted nothing — which is a claim about what happened in
/// front of a picture rather than about the opinion a reader thinks they ought
/// to hold.
///
/// Keyed on `driftId` rather than on a user, because requiring an account
/// before the first card would cost the reading the only people it is for. The
/// id is a random token in a signed cookie — deliberately not `sessionId`, which
/// in this schema means a login. `userId` is filled in when a signed-in reader
/// passes through, so a drift can later be attributed without the anonymous ones
/// being orphaned.
///
/// REST is stored, not skipped. "This exerted nothing on me" is the observation
/// that keeps `pulled / (pulled + pushed)` from being computed over a sample the
/// reader silently curated, and it is what marks a card as seen so the deck does
/// not offer it twice.
model DriftVerdict {
  id         String  @id @default(cuid())
  driftId    String  @map("drift_id")
  userId     String? @map("user_id")
  resourceId Int     @map("resource_id")
  /// PULL | PUSH | REST.
  verdict    String
  /// Which deck the card came from: SPREAD (a cluster representative) or
  /// NEAREST (drawn towards the drift vector). Kept so the readout can say how
  /// much of the drift was exploration and how much was confirmation.
  origin     String  @default("SPREAD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([driftId, resourceId])
  @@index([driftId, createdAt])
  @@index([userId])
}

model Music {
  id              Int               @id @default(autoincrement())
  source          String
  trackName       String            @map("track_name")
  artistName      String            @map("artist_name")
  album           String
  isrc            String            @unique
  spotifyId       String            @unique @map("spotify_id")
  country         String
  genre           String
  releaseYear     Int               @map("release_year")
  youtubeUrl      String            @default("") @map("youtube_url")
  highlight       Boolean           @default(false)
  confessionLinks ConfessionMusic[]

  @@index([highlight])
}

model Confession {
  id         Int               @id @default(autoincrement())
  confession String
  likeCount  Int               @default(0)
  musicExp   String?
  artExp     String?
  mood       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?
  score      Int?
  comments   Comment[]
  musicLinks ConfessionMusic[]
  artLinks   ConfessionArt[]
}

model ConfessionMusic {
  id           Int @id @default(autoincrement())
  confessionId Int
  musicId      Int

  confession Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  music      Music      @relation(fields: [musicId], references: [id])
}

model ConfessionArt {
  id           Int @id @default(autoincrement())
  confessionId Int
  artId        Int

  confession Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
  art        Resource   @relation(fields: [artId], references: [id])
}

model Comment {
  id           Int       @id @default(autoincrement())
  confessionId Int
  text         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  confession Confession @relation(fields: [confessionId], references: [id], onDelete: Cascade)
}

model PdfDownload {
  id        Int      @id @default(autoincrement())
  fileName  String
  ipAddress String?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SearchSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  query     String
}
