# Copy to .dev.vars for the Cloudflare Vite development runtime (`npm run
# dev:worker`). The Node harness (`npm run dev`) reads .env instead.
#
# Bindings are not set here: `wrangler dev` simulates Hyperdrive from the
# `localConnectionString` in wrangler.jsonc, and KV and the rate limiters from
# local state.
SESSION_SECRET="super-duper-s3cret"
HONEYPOT_SECRET="super-duper-s3cret"
ALLOW_INDEXING="false"

AWS_ACCESS_KEY_ID="mock-access-key"
AWS_SECRET_ACCESS_KEY="mock-secret-key"
AWS_REGION="eu-central-1"
AWS_S3_BUCKET="mock-bucket"

# Optional integrations
SENTRY_DSN=""
RESEND_API_KEY=""
GITHUB_CLIENT_ID="MOCK_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="MOCK_GITHUB_CLIENT_SECRET"
GITHUB_TOKEN="MOCK_GITHUB_TOKEN"
GITHUB_REDIRECT_URI="https://example.com/auth/github/callback"
