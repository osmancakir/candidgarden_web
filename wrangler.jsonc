{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "candidgarden",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "./build/client",
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"persist": true,
		},
	},
	"vars": {
		"ALLOW_INDEXING": "false",
	},
	"secrets": {
		"required": [
			"SESSION_SECRET",
			"HONEYPOT_SECRET",
			"AWS_ACCESS_KEY_ID",
			"AWS_SECRET_ACCESS_KEY",
			"AWS_REGION",
			"AWS_S3_BUCKET",
		],
	},
	// Wrangler environments do not inherit bindings from the top level, so every
	// binding below is repeated verbatim in `env.staging` and `env.production`.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgresql://candidgarden:candidgarden@localhost:5432/candidgarden?schema=public",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE_KV",
			"id": "00000000000000000000000000000000",
		},
	],
	// Tiers mirror the Node harness in `server/index.ts`; both classify paths
	// through `app/utils/rate-limit.server.ts`. `period` accepts only 10 or 60.
	// `namespace_id` is an arbitrary but stable per-Worker identifier.
	"ratelimits": [
		{
			"name": "STRONGEST_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			},
		},
		{
			"name": "STRONG_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 100,
				"period": 60
			},
		},
		{
			"name": "GENERAL_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": {
				"limit": 1000,
				"period": 60
			},
		},
	],
	"env": {
		"staging": {
			"name": "candidgarden-staging",
			"vars": {
				"ALLOW_INDEXING": "false",
			},
			"secrets": {
				"required": [
					"SESSION_SECRET",
					"HONEYPOT_SECRET",
					"AWS_ACCESS_KEY_ID",
					"AWS_SECRET_ACCESS_KEY",
					"AWS_REGION",
					"AWS_S3_BUCKET",
				],
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000",
				},
			],
			"kv_namespaces": [
				{
					"binding": "CACHE_KV",
					"id": "cd60cd741495480ca6eb64e3192fb3f4",
				},
			],
			"ratelimits": [
				{
					"name": "STRONGEST_RATE_LIMIT",
					"namespace_id": "1001",
					"simple": {
						"limit": 10,
						"period": 60
					},
				},
				{
					"name": "STRONG_RATE_LIMIT",
					"namespace_id": "1002",
					"simple": {
						"limit": 100,
						"period": 60
					},
				},
				{
					"name": "GENERAL_RATE_LIMIT",
					"namespace_id": "1003",
					"simple": {
						"limit": 1000,
						"period": 60
					},
				},
			],
		},
		"production": {
			"name": "candidgarden",
			// Routes (not custom domains) intercept requests at the Cloudflare edge
			// ahead of whatever the proxied DNS records point at, so the apex and
			// www records can stay untouched. Switch these to `custom_domain: true`
			// once the old origin is decommissioned and its A records are removed.
			"routes": [
				{
					"pattern": "candidgarden.com/*",
					"zone_name": "candidgarden.com",
				},
				{
					"pattern": "www.candidgarden.com/*",
					"zone_name": "candidgarden.com",
				},
			],
			"vars": {
				"ALLOW_INDEXING": "true",
			},
			"secrets": {
				"required": [
					"SESSION_SECRET",
					"HONEYPOT_SECRET",
					"AWS_ACCESS_KEY_ID",
					"AWS_SECRET_ACCESS_KEY",
					"AWS_REGION",
					"AWS_S3_BUCKET",
				],
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "48aaabf6c3d843fbbe6d22bedf28a355",
				},
			],
			"kv_namespaces": [
				{
					"binding": "CACHE_KV",
					"id": "71cd19f54ca4495babfadf0ed67a9cf2",
				},
			],
			"ratelimits": [
				{
					"name": "STRONGEST_RATE_LIMIT",
					"namespace_id": "1001",
					"simple": {
						"limit": 10,
						"period": 60
					},
				},
				{
					"name": "STRONG_RATE_LIMIT",
					"namespace_id": "1002",
					"simple": {
						"limit": 100,
						"period": 60
					},
				},
				{
					"name": "GENERAL_RATE_LIMIT",
					"namespace_id": "1003",
					"simple": {
						"limit": 1000,
						"period": 60
					},
				},
			],
		},
	},
}